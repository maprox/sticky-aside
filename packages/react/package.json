{
  "name": "@sticky-aside/react",
  "version": "1.1.0",
  "description": "React adapter for @sticky-aside/core.",
  "keywords": ["sticky", "sidebar", "aside", "scroll", "react"],
  "license": "MIT",
  "author": "maprox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maprox/sticky-aside.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/maprox/sticky-aside#readme",
  "bugs": "https://github.com/maprox/sticky-aside/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/StickyAside.tsx"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/StickyAside.d.ts",
        "import": "./dist/StickyAside.js"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "pnpm --dir ../.. exec tsdown --config packages/react/tsdown.config.mjs"
  },
  "dependencies": {
    "@sticky-aside/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
