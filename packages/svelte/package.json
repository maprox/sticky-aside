{
  "name": "@sticky-aside/svelte",
  "version": "1.1.2",
  "description": "Svelte adapter for @sticky-aside/core.",
  "keywords": [
    "sticky",
    "sidebar",
    "aside",
    "scroll",
    "svelte"
  ],
  "license": "MIT",
  "author": "maprox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maprox/sticky-aside.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://maprox.github.io/sticky-aside/",
  "bugs": "https://github.com/maprox/sticky-aside/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist --tsconfig ./tsconfig.json && node ./clean-dist.mjs"
  },
  "dependencies": {
    "@sticky-aside/core": "workspace:^"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.57.2",
    "svelte-preprocess": "^6.0.5"
  }
}
