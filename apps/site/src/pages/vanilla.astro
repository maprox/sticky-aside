---
import Base from '../layouts/Base.astro'
import { articleLines } from '../demo/copy'
---

<Base title="Vanilla — sticky-aside" active="vanilla">
  <h2 class="sandbox-title">Vanilla</h2>
  <div class="demo">
    <article class="article">
      {articleLines.map((line) => <p>{line}</p>)}
    </article>
    <div class="rail" id="vanilla-rail"></div>
  </div>
</Base>

<script>
  import { mountPanel } from '../scripts/mount-panel'
  const rail = document.querySelector<HTMLElement>('#vanilla-rail')
  if (rail) mountPanel(rail, { controls: true, tall: true })
</script>
