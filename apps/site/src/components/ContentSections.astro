---
import { landingContent } from '../demo/landing-content'
import type { DemoFramework, DemoLocale } from '../demo/settings'

interface Props {
  locale: DemoLocale
  framework: DemoFramework
}

const { locale, framework } = Astro.props
const content = landingContent(locale, framework)
---

<div class="content-sections" data-content-sections>
  <section aria-labelledby="installation-title">
    <h2 id="installation-title">{content.installation.title}</h2>
    <p>{content.installation.body}</p>
    <pre class="install-command"><code>{content.installation.command}</code></pre>
  </section>

  <section aria-labelledby="explanation-title">
    <h2 id="explanation-title">{content.explanation.title}</h2>
    {content.explanation.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section aria-labelledby="integration-title">
    <h2 id="integration-title">{content.integration.title}</h2>
    <p>{content.integration.body}</p>
    <p class="content-links">
      <a href={content.integration.docsHref}>{content.integration.docsLabel}</a>
      <a href={content.integration.npmHref}>{content.integration.npmLabel}</a>
    </p>
  </section>

  <section aria-labelledby="limitations-title">
    <h2 id="limitations-title">{content.limitations.title}</h2>
    <ul>
      {content.limitations.items.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</div>

<style>
  .content-sections {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 48px;
    max-width: 1100px;
    margin-top: 64px;
  }

  .content-sections section { min-width: 0; }

  .content-sections h2 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .content-sections p,
  .content-sections li {
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .content-sections p { margin: 0 0 12px; }

  .content-sections ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .content-sections li + li { margin-top: 8px; }

  .install-command {
    margin: 16px 0 0;
    padding: 14px 16px;
    overflow-x: auto;
    border-radius: 12px;
    background: #fbfaf7;
    box-shadow: inset 0 0 0 1px rgba(29, 26, 23, 0.08);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .content-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .content-links a { text-underline-offset: 3px; }

  :global(html[data-theme="dark"]) .install-command {
    background: #221e1b;
    box-shadow: inset 0 0 0 1px rgba(243, 236, 227, 0.1);
  }

  @media (max-width: 800px) {
    .content-sections {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-top: 48px;
    }
  }
</style>
